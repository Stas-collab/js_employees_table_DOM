    textTitel.classList.add("title");
    textTitel.textContent = title;
    container.appendChild(textTitel);
    var textDescription = document.createElement("p");
    textDescription.textContent = description;
    container.appendChild(textDescription);
    if (type === "success") container.classList.add("success");
    if (type === "error") container.classList.add("error");
    if (type === "warning") container.classList.add("warning");
